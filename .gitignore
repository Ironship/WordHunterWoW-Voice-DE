# The audio itself. Hundreds of gigabytes of generated speech do not belong in
# git; the tools rebuild it from the corpus and it ships as release assets.
/sounds/
# The work list, rebuilt from the corpus in seconds and far too big to keep.
/Data/lines.jsonl
/build/
/.venv/
/demo/
generate*.log
generate.err
# Cross-check fixtures, regenerated by the tools that write them.
tests/_texts.txt
tests/_counts.txt
/.scratch/
# Reference recordings are audio, not source. The narrator is the exception:
# it is 450 KB, it is redistributable, and a pack nobody can reproduce the voice
# of is a pack nobody else can extend.
/voices/*.wav
!/voices/narrator.wav
!/voices/female.wav
# Auditioned readers that were not chosen. Working files: a few megabytes of
# other people's fairy tales, kept only long enough to pick from.
/voices/_candidates/
/release/
/curseforge/
*.zip
__pycache__/
.DS_Store
Thumbs.db
desktop.ini
*scratchpad*
*AppData*
