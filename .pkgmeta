# What the engine addon is made of, as against the corpus around it.
#
# Nothing is published from this repository on its own any more: every sound
# pack carries a copy of the engine, put there by Tools/build_merged.py, which
# reads the manifest for the file list. This file stays because
# Tools/pack_release.py and Tools/install_dev.sh read the ignore list below to
# tell the addon from the audio, the build tree and the generator's logs.
package-as: WordHunterWoW-Voice-DE

enable-nolib-creation: no

ignore:
  - Tools
  - tests
  - voices
  - sounds
  - build
  # Inputs to the generator, not to the game: the quest-to-speaker map alone is
  # 941 KB and the client cannot read a .json at all. Only Data/lines.jsonl is
  # kept out of git, so without this line every release carried well over a
  # megabyte that nothing in the addon opens.
  - Data
  # The generator's own leavings, all three tracked in git from before there was
  # a rule against it. generate.err alone is 1.1 MB -- larger than every source
  # file in the addon put together -- and generuj.bat carries an absolute path
  # from the machine that wrote it. None of the three is anything the client can
  # load, so every release so far would have carried them for nothing.
  - generate.err
  - generate.log
  - generuj.bat
  # This repository's own bookkeeping; the client cannot read it.
  - .gitignore
